[Unit]
Description=MCP Call-Orchestrator Proxy (resilient, serializing FastMCP proxy in front of a backend MCP server)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# WorkingDirectory and ExecStart below are filled in by the install step in
# the README ("Run as a systemd user service", step 3).
WorkingDirectory=__REPO_ROOT__
ExecStart=__REPO_ROOT__/.venv/bin/mcp-call-orchestrator-proxy run --transport streamable-http

# Backend: a standard mcpServers JSON file holding the URL + auth token.
# Copy deploy/systemd/backend.example.json to this path, fill it in, and
# chmod 600 it (see README step 2). %h expands to this user's home directory
# here because it's inside a unit directive - unlike inside an
# EnvironmentFile=, whose content systemd reads literally with no expansion.
Environment=MCP_PROXY_BACKEND_CONFIG=%h/.config/mcp-call-orchestrator-proxy/backend.json
# TLS verification is separate from the JSON (the format has no verify field).
# Leave false for a self-signed backend cert (common for local MCP servers):
Environment=MCP_PROXY_BACKEND_VERIFY_TLS=false

# Optional: override defaults by uncommenting. See README's configuration
# table. Changing any of these requires `systemctl --user daemon-reload`.
# Running more than one instance (e.g. one per backend)? Give each a distinct
# MCP_PROXY_SERVER_NAME - some MCP clients (e.g. VS Code/Copilot's tool
# picker) label/dedupe servers by this reported identity, not by whatever key
# you gave the entry in your own client config, so identical names make
# separate instances indistinguishable there.
#Environment=MCP_PROXY_SERVER_NAME=mcp-call-orchestrator-proxy
#Environment=MCP_PROXY_LISTEN_HOST=127.0.0.1
#Environment=MCP_PROXY_LISTEN_PORT=27125
#Environment=MCP_PROXY_MAX_CONCURRENT_CALLS=1
#Environment=MCP_PROXY_CALL_TIMEOUT_SECONDS=120
#Environment=MCP_PROXY_CONNECT_TIMEOUT_SECONDS=30
#Environment=MCP_PROXY_RECONNECT_INITIAL_BACKOFF_SECONDS=1
#Environment=MCP_PROXY_RECONNECT_MAX_BACKOFF_SECONDS=30
#Environment=MCP_PROXY_RECONNECT_BACKOFF_MULTIPLIER=2
#Environment=MCP_PROXY_BACKEND_HEALTH_POLL_SECONDS=5

# Exposure control (exact names only; blank/unset = full surface). When both
# allow and deny are set for one surface, allow wins. Include backend_status
# on a tool allow-list if clients should keep the health-check tool. See
# README "Exposure control".
#Environment=MCP_PROXY_TOOL_ALLOW=echo,slow_echo,backend_status
#Environment=MCP_PROXY_TOOL_DENY=hang,crash
#Environment=MCP_PROXY_RESOURCE_ALLOW=
#Environment=MCP_PROXY_RESOURCE_DENY=
#Environment=MCP_PROXY_PROMPT_ALLOW=
#Environment=MCP_PROXY_PROMPT_DENY=

# Logging. INFO (the default) shows the queue working - one record per call on
# arrival and one on completion. Raise to DEBUG to chase a fault, then
# `systemctl --user restart` - no rebuild needed. See the README's "Logs" section.
#Environment=MCP_PROXY_LOG_LEVEL=DEBUG

Restart=on-failure
RestartSec=2
# The resilience layer's shutdown is prompt by design (interruptible backoff,
# measured ~0.17s even mid-backoff) - no need for a long stop timeout.
TimeoutStopSec=10

# Light sandboxing. Kept minimal on purpose: this is a loopback-only local
# service with no filesystem writes, so we don't fight ProtectSystem/ProtectHome
# during first-time setup debugging.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

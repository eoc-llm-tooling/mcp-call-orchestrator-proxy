# Copy this file to
#   ~/.config/mcp-call-orchestrator-proxy/mcp-call-orchestrator-proxy.env
# and fill in your real values, then lock down its permissions:
#
#   chmod 600 ~/.config/mcp-call-orchestrator-proxy/mcp-call-orchestrator-proxy.env
#
# All variables are prefixed MCP_PROXY_.
#
# This file is only used by the mcp-call-orchestrator-proxy-envfile.service
# variant. The default mcp-call-orchestrator-proxy.service sets everything
# (including the path to backend.json) directly in the unit and doesn't need
# this file at all - use this variant instead if you want the raw
# MCP_PROXY_BACKEND_API_KEY / MCP_PROXY_BACKEND_MCP_URL fields (Option 2)
# rather than a JSON backend config, or just prefer secrets out of the unit
# file entirely.
#
# NOTE: unlike the unit file itself, this file is read literally by systemd's
# EnvironmentFile= - no specifier (%h) or shell ($HOME) expansion happens
# inside it. Any paths below must be written out in full (e.g.
# /home/youruser/... not %h/...).

# --- Option 2: individual fields ------------------------------------------
# Set the URL and bearer token for your backend MCP server.
MCP_PROXY_BACKEND_API_KEY=replace-with-your-real-api-key
#MCP_PROXY_BACKEND_MCP_URL=https://127.0.0.1:27124/mcp/
#MCP_PROXY_BACKEND_VERIFY_TLS=false

# --- Or: point at a standard mcpServers JSON config file instead ----------
# (Same option the default unit uses - use an absolute path, not %h.)
#MCP_PROXY_BACKEND_CONFIG=/home/youruser/.config/mcp-call-orchestrator-proxy/backend.json

# --- Optional: override defaults. See README's configuration table. --------
# Running more than one instance (e.g. one per backend)? Give each a distinct
# MCP_PROXY_SERVER_NAME - some MCP clients (e.g. VS Code/Copilot's tool
# picker) label/dedupe servers by this reported identity, not by whatever key
# you gave the entry in your own client config, so identical names make
# separate instances indistinguishable there.
#MCP_PROXY_SERVER_NAME=mcp-call-orchestrator-proxy
#MCP_PROXY_LISTEN_HOST=127.0.0.1
#MCP_PROXY_LISTEN_PORT=27125
#MCP_PROXY_MAX_CONCURRENT_CALLS=1
#MCP_PROXY_CALL_TIMEOUT_SECONDS=120
#MCP_PROXY_CONNECT_TIMEOUT_SECONDS=30
#MCP_PROXY_RECONNECT_INITIAL_BACKOFF_SECONDS=1
#MCP_PROXY_RECONNECT_MAX_BACKOFF_SECONDS=30
#MCP_PROXY_RECONNECT_BACKOFF_MULTIPLIER=2
#MCP_PROXY_BACKEND_HEALTH_POLL_SECONDS=5

# Exposure control (exact names only; blank/unset = full surface). When both
# allow and deny are set for one surface, allow wins. Include backend_status
# on a tool allow-list if clients should keep the health-check tool. See
# README "Exposure control".
#MCP_PROXY_TOOL_ALLOW=echo,slow_echo,backend_status
#MCP_PROXY_TOOL_DENY=hang,crash
#MCP_PROXY_RESOURCE_ALLOW=
#MCP_PROXY_RESOURCE_DENY=
#MCP_PROXY_PROMPT_ALLOW=
#MCP_PROXY_PROMPT_DENY=

# Logging. INFO (the default) shows the queue working - a record per call as it
# arrives and as it completes. Raise to DEBUG when chasing a fault; drop to
# WARNING for outages only. See the README's "Logs" section.
#MCP_PROXY_LOG_LEVEL=INFO
